#!/bin/sh
set -eu

export PATH=/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /mnt/card

mount -t appendfat /dev/vda /mnt/card
printf 'baseline-before-cut\n' > /mnt/card/baseline.txt
sync
printf 'durable-before-cut\n' > /mnt/card/durable.txt
sync

echo APPENDFAT_QEMU_POWER_CUT_READY

while :
do
    sleep 60
done
