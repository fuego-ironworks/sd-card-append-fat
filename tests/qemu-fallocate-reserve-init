#!/bin/sh
set -eu

export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /mnt/card

grep -w appendfat /proc/filesystems >/dev/null
mount -t appendfat /dev/vda /mnt/card

printf 'prefix' > /mnt/card/reserved.bin
/bin/fallocate_keep_size reserve /mnt/card/reserved.bin 0 262144
/bin/fallocate_keep_size check /mnt/card/reserved.bin 6 prefix 120

: > /mnt/card/empty-reserved.bin
/bin/fallocate_keep_size reserve /mnt/card/empty-reserved.bin 0 131072
/bin/fallocate_keep_size check /mnt/card/empty-reserved.bin 0 - -1

sync
umount /mnt/card

echo APPENDFAT_KEEP_SIZE_RESERVE_PASS
poweroff -f
