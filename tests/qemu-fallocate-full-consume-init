#!/bin/sh
set -eu

export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /mnt/card

grep -w vfat /proc/filesystems >/dev/null
grep -w appendfat /proc/filesystems >/dev/null

mount -t appendfat /dev/vda /mnt/card
/bin/fallocate-keep-size check /mnt/card/reserved.bin 65542 prefix 65
/bin/fallocate-keep-size check /mnt/card/empty-reserved.bin 32768 - 66
/bin/fallocate-keep-size blocks /mnt/card/reserved.bin 129
/bin/fallocate-keep-size blocks /mnt/card/empty-reserved.bin 64
/bin/fallocate-keep-size append /mnt/card/reserved.bin 196602 67
/bin/fallocate-keep-size check /mnt/card/reserved.bin 262144 prefix 67
/bin/fallocate-keep-size blocks /mnt/card/reserved.bin 512
/bin/fallocate-keep-size append /mnt/card/empty-reserved.bin 98304 68
/bin/fallocate-keep-size check /mnt/card/empty-reserved.bin 131072 - 68
/bin/fallocate-keep-size blocks /mnt/card/empty-reserved.bin 256
sync
umount /mnt/card

mount -t vfat /dev/vda /mnt/card
/bin/fallocate-keep-size check /mnt/card/reserved.bin 262144 prefix 67
/bin/fallocate-keep-size check /mnt/card/empty-reserved.bin 131072 - 68
/bin/fallocate-keep-size blocks /mnt/card/reserved.bin 512
/bin/fallocate-keep-size blocks /mnt/card/empty-reserved.bin 256
sync
umount /mnt/card

echo APPENDFAT_KEEP_SIZE_FULL_CONSUME_PASS
poweroff -f
